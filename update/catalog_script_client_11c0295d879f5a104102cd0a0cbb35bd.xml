        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue == '') {
        return;
    }

    var ga = new GlideAjax('UserInfoUtils');
    ga.addParam('sysparm_name', 'getUserInformationUtilsByID');
    ga.addParam('sysparm_sys_id', newValue);
    ga.getXML(parseResponse);

    function parseResponse(response) {
        var answer = JSON.parse(response.responseXML.documentElement.getAttribute("answer"));
        if (answer) {
            g_form.addInfoMessage(JSON.stringify(answer));
			g_form.setValue("collaborator_job_company",answer.comp);
			g_form.setValue("collaborator_job_department",answer.dept);
			g_form.setValue("collaborator_job_title",answer.funct);
			g_form.setValue("collaborator_job_commitment_date",answer.commitment_date);
        }
    }

}]]></script>
